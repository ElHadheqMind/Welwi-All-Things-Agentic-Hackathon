# --- Gemini ---
# Local/dev: hit the Gemini API directly with an API key (fast to test with).
# Deploy: switch to Vertex AI (GOOGLE_GENAI_USE_VERTEXAI=TRUE + project/location,
# no API key needed) so Agent Engine runs it server-side under a service account.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
WELWI_MODEL=gemini-3.6-flash
# Voice companion (welwi_voice_agent) — native-audio Live API model.
# Verified available in us-central1 (not global) on Vertex.
WELWI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- Firestore (notes, events cache, feedback log) ---
FIRESTORE_DATABASE=(default)

# --- Google Calendar API ---
# Path to an OAuth client token (see agent_backend/README.md for how to mint one).
GOOGLE_CALENDAR_TOKEN_PATH=./secrets/calendar_token.json
GOOGLE_CALENDAR_ID=primary
